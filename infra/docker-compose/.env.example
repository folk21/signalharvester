# Safe local-development defaults only. Do not reuse these credentials in production.
# Copy to infra/docker-compose/.env and pass it with Docker Compose's --env-file option.

SIGNALHARVESTER_DB_NAME=signalharvester
SIGNALHARVESTER_DB_USERNAME=signalharvester
SIGNALHARVESTER_DB_PASSWORD=signalharvester
SIGNALHARVESTER_DB_PORT=5432

SIGNALHARVESTER_KAFKA_ADVERTISED_HOST=localhost
SIGNALHARVESTER_KAFKA_PORT=9092
SIGNALHARVESTER_REDPANDA_ADMIN_PORT=9644

# Application runtime values. Keep these aligned with the Compose host bindings above
# when overriding the default database name or host ports.
SIGNALHARVESTER_DB_URL=jdbc:postgresql://localhost:5432/signalharvester
SIGNALHARVESTER_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SIGNALHARVESTER_COLLECTION_RSS_MAX_ITEMS_PER_SOURCE=500
SIGNALHARVESTER_KAFKA_RAW_ITEM_DISCOVERED_TOPIC=signalharvester.collection.raw-item-discovered.v1
SIGNALHARVESTER_KAFKA_ITEM_ANALYZED_TOPIC=signalharvester.analysis.item-analyzed.v1
SIGNALHARVESTER_KAFKA_ITEM_REJECTED_TOPIC=signalharvester.analysis.item-rejected.v1
SIGNALHARVESTER_RESULTS_ENABLED=true
SIGNALHARVESTER_RESULTS_CONSUMER_GROUP=signalharvester-results-v1
