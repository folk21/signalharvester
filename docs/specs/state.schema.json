{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Specification processing-state record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "selectedWorkstreamId",
    "workstreams"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "const": "SINGLE"
    },
    "selectedWorkstreamId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "workstreams": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "specPath",
          "stageId",
          "phase",
          "runId",
          "developerDecision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "specPath": {
            "type": "string",
            "pattern": "^docs/specs/active/subspecs/[a-z0-9][a-z0-9-]*\\.md$"
          },
          "stageId": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Za-z0-9.]*$"
          },
          "phase": {
            "enum": [
              "DESIGN",
              "READY_TO_DELEGATE",
              "READY_FOR_REVIEW",
              "BLOCKED",
              "PAUSED",
              "ON_HOLD",
              "AWAITING_DEVELOPER_DECISION"
            ],
            "description": "Developer-maintained Git checkpoint, not runtime or acceptance. ON_HOLD is a deferred non-selected workstream; PAUSED is a temporarily stopped workstream. RUNNING and ACCEPTED are unsupported."
          },
          "runId": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            ]
          },
          "developerDecision": {
            "enum": [
              "UNRECORDED",
              "REJECTED"
            ]
          }
        }
      }
    }
  },
  "description": "Strict repository checkpoint shape, not an acceptance receipt or a runtime state machine."
}
